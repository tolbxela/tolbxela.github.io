---
import Base from '../layouts/Base.astro';
import Mail from '../components/Mail.astro';

const socials = [
  { label: 'GitHub',  href: 'https://github.com/tolbxela' },
  { label: 'Twitter', href: 'https://twitter.com/tolbxela' },
  { label: 'Medium',  href: 'https://medium.com/@tolbxela' },
  { label: 'dev.to',  href: 'https://dev.to/tolbxela' },
  { label: 'Flickr',  href: 'https://www.flickr.com/people/tolbxela/' },
  { label: 'Last.fm', href: 'https://last.fm/user/tolbxela' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UCWKFQN85ISBanztuspXR-PA' },
];
---
<Base title="About · Tolbxela">
  <img src="/avatar.png" alt="Tolbxela" class="avatar" />
  <h1>About</h1>
  <p class="muted">A short bio.</p>

  <p>
    I'm Tolbxela. I build small, useful things across web, mobile, and lately AI tooling.
    Past work has touched photography (Aerostat, MusHub, 500px integrations) and Android apps;
    current focus is developer tooling for AI coding agents.
  </p>

  <h2>Writing</h2>
  <p>
    I occasionally write about what I build - mostly developer tooling and notes from
    side projects - on
    <a href="https://medium.com/@tolbxela" rel="me noopener">Medium</a> and
    <a href="https://dev.to/tolbxela" rel="me noopener">dev.to</a>.
  </p>

  <h2>Elsewhere</h2>
  <ul class="socials">
    {socials.map(s => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
    <li><Mail user="email" label="Email" /></li>
  </ul>

  <h2>Hire me</h2>
  <p>
    Need a personal page, portfolio, or simple landing site? I build the whole thing -
    design, code, domain, and hosting. <a href="/contact">Get in touch &rarr;</a>
  </p>
</Base>

---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base title="Contact · Tolbxela" description="Want a small site? Get in touch.">
  <h1>Contact</h1>
  <p class="muted">
    Need a personal page, portfolio, or simple landing site? I build the whole thing -
    design, code, domain, and hosting. Tell me a bit about it and I'll reply.
  </p>

  <ContactForm
    subject="tolbxela.com - site enquiry"
    fromName="tolbxela.com"
  />
</Base>

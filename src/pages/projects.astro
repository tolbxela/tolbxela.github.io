---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'TaskDev',
    year: '2026',
    tags: ['VS Code', 'Extension', 'MCP', 'AI agents'],
    desc: 'A task runner for AI coding agents. Exposes long-running dev tasks (servers, watchers, builds) to Claude Code and other MCP clients so the agent can start, stop, restart, and read logs without taking over the terminal.',
    links: [
      { href: 'https://open-vsx.org/extension/tolbxela/taskdev', label: 'Open VSX' },
      { href: 'https://marketplace.visualstudio.com/items?itemName=Tolbxela.taskdev', label: 'VS Code' },
      { href: 'https://github.com/tolbxela/taskdev', label: 'GitHub' },
      { href: 'https://medium.com/@tolbxela/taskdev-a-task-runner-for-ai-coding-agents-mcp-e4adf4902488', label: 'Medium' },
      { href: 'https://dev.to/tolbxela/taskdev-a-task-runner-for-ai-coding-agents-mcp-3kg1', label: 'dev.to' },
    ],
  },
];
---
<Base title="Projects · Tolbxela">
  <h1>Projects</h1>
  <p class="muted">What I'm currently building.</p>

  <h2>Active</h2>
  <ul class="card-list">
    {projects.map(p => (
      <li>
        <article class="card">
          <div class="card-head">
            <h3>{p.name}</h3>
            <span class="card-meta">{p.year}</span>
          </div>
          <p class="card-desc">{p.desc}</p>
          <ul class="tags">{p.tags.map(t => <li class="tag">{t}</li>)}</ul>
          <div class="card-links">
            {p.links.map(l => <a href={l.href}>{l.label} →</a>)}
          </div>
        </article>
      </li>
    ))}
  </ul>
</Base>

---
import Base from '../layouts/Base.astro';
---
<Base>
  <section class="hero">
    <img src="/avatar.png" alt="Tolbxela" class="avatar" />
    <h1>Tolbxela</h1>
    <p class="lead">Builder of small things - programming, web, AI tooling.</p>
    <p class="muted">
      Currently working on <a href="https://taskdev.dev">TaskDev</a>, a task runner for AI coding agents
      - <a href="/projects">more projects</a>.
    </p>
  </section>

  <h2>Writing</h2>
  <p>
    I write about what I build on
    <a href="https://medium.com/@tolbxela" rel="me noopener">Medium</a> and
    <a href="https://dev.to/tolbxela" rel="me noopener">dev.to</a>.
  </p>

  <h2>Hire me</h2>
  <p>
    Need a personal page, portfolio, or simple landing site? I build the whole thing -
    design, code, domain, and hosting. <a href="/contact">Get in touch &rarr;</a>
  </p>
</Base>

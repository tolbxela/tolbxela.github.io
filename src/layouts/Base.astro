---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

const { title = "Tolbxela", description = "Tolbxela's Place" } = Astro.props;

const bg1x = '/bg/bg-1920.webp';
const bg2x = '/bg/bg-2560.webp';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tolbxela" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="google-site-verification" content="GA5zLJpMfcnhklnsF-1uTnYc2gadjxWCQo55aAgAxwU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bg1x} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="dc390dd6-a327-454f-91c7-cede5968fd91"></script>
    <link rel="preload" as="image" href={bg1x} />
    <style is:inline set:html={`
      body { background-image: url(${bg1x}); }
      @media (min-resolution: 1.5dppx), (min-width: 1800px) {
        body { background-image: url(${bg2x}); }
      }
    `}></style>
  </head>
  <body>
    <main>
      <Nav />
      <slot />
      <footer>&copy; {new Date().getFullYear()} Tolbxela &middot; <a href="/privacy">Privacy</a></footer>
    </main>
    <script is:inline>
      document.querySelectorAll('a.mail').forEach(function (a) {
        var u = a.getAttribute('data-u');
        var h = a.getAttribute('data-h');
        if (!u || !h) return;
        var addr = u + '@' + h;
        a.setAttribute('href', 'mailto:' + addr);
        if (a.dataset.reveal !== 'false') a.textContent = addr;
      });
    </script>
  </body>
</html>
